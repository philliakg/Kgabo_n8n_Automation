{
  "id": "StudentFeedback1",
  "name": "Student Feedback Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "student-feedback",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000001",
      "name": "Receive Feedback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "5f3b2c8e-7d1a-4b6e-9c2f-1a2b3c4d5e6f"
    },
    {
      "parameters": {
        "jsCode": "// get the data that the form sent\nconst body = $input.first().json.body;\n\nlet errors = [];\n\n// check student name\nif (!body.studentName || body.studentName.trim() === '') {\n  errors.push('Student name is missing');\n}\n\n// check email\nif (!body.email || body.email.trim() === '') {\n  errors.push('Email is missing');\n} else if (!body.email.includes('@')) {\n  errors.push('Email is not valid');\n}\n\n// check course\nif (!body.courseName || body.courseName.trim() === '') {\n  errors.push('Course name is missing');\n}\n\n// check rating\nif (!body.rating) {\n  errors.push('Rating is missing');\n} else if (Number(body.rating) < 1 || Number(body.rating) > 5) {\n  errors.push('Rating must be between 1 and 5');\n}\n\n// check feedback\nif (!body.feedback || body.feedback.trim() === '') {\n  errors.push('Feedback message is missing');\n}\n\nif (errors.length > 0) {\n  return [{ json: { isValid: false, errorMessage: errors.join(', ') } }];\n}\n\nreturn [{\n  json: {\n    isValid: true,\n    studentName: body.studentName.trim(),\n    email: body.email.trim(),\n    courseName: body.courseName.trim(),\n    rating: Number(body.rating),\n    feedback: body.feedback.trim(),\n    submittedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "a1f0c001-0000-4000-8000-000000000002",
      "name": "Validate Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c0nd0001-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.isValid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000003",
      "name": "Is Data Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"message\": \"{{ $json.errorMessage }}\"\n}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000004",
      "name": "Respond With Error",
      "type": "n8n-nodes-base.respondToWebhook",
